{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
  <title>{{ .Site.Title }}</title>
  <link>{{ .Permalink }}</link>
  <description>{{ .Site.Params.description }}</description>
  {{ $pages := .RegularPages }}
  {{ if .IsHome }}{{ $pages = .Site.RegularPages }}{{ end }}
  <language>{{ (partial "language.html" .Site.Language).locale }}</language>
  {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
  {{ $pages = partial "discoverable-pages.html" $pages }}
  {{ $limit := .Site.Config.Services.RSS.Limit }}
  {{ if ge $limit 0 }}{{ $pages = first $limit $pages }}{{ end }}
  {{ range $pages }}
  <item>
    <title>{{ .Title }}</title><link>{{ .Permalink }}</link>
    <guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ printf "%s" .Summary }}</description>
  </item>
  {{ end }}
</channel></rss>

{
  "name": "unbloated",
  "version": "0.1.0",
  "description": "Monospace grayscale CSS library for engineers",
  "license": "LGPL-3.0-only",
  "author": "Jorge Martinez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgepiloto/unbloated.git"
  },
  "homepage": "https://github.com/jorgepiloto/unbloated#readme",
  "bugs": "https://github.com/jorgepiloto/unbloated/issues",
  "keywords": [
    "css",
    "theme",
    "monospace",
    "design-tokens",
    "unbloat"
  ],
  "type": "module",
  "style": "./dist/unbloat.css",
  "sass": "./dist/_tokens.scss",
  "unpkg": "./dist/unbloat.css",
  "jsdelivr": "./dist/unbloat.css",
  "exports": {
    ".": "./dist/unbloat.css",
    "./unbloat.css": "./dist/unbloat.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./tokens.scss": "./dist/_tokens.scss",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/build.mjs",
    "LICENSE",
    "COPYING",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:adapters": "npm run build && node scripts/adapters.mjs",
    "check:adapters": "node scripts/adapters.mjs --check",
    "lint:adapters": "node scripts/adapter-styles.mjs",
    "test:adapters": "node --test tests/adapters.test.mjs tests/adapter-packages.integration.mjs",
    "pack:adapters": "node scripts/pack-adapters.mjs",
    "build:check": "node scripts/build.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run build:check && npm test && npm run test:browser",
    "prepack": "npm run build",
    "preview": "node scripts/serve.mjs",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "biome lint src examples docs/assets/site.css packages --error-on-warnings",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:adapters",
    "docs:project": "node scripts/project-docs.mjs",
    "test:project-docs": "playwright test --config playwright.projects.config.mjs",
    "docs:build": "node scripts/docs.mjs build",
    "docs:dev": "node scripts/docs.mjs serve",
    "docs:preview": "node scripts/docs.mjs preview",
    "test:docs": "playwright test --config playwright.docs.config.mjs",
    "docs:setup": "node scripts/docs.mjs setup",
    "test:adapter-browser": "playwright test --config playwright.adapters.config.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "sass": "1.105.1"
  }
}

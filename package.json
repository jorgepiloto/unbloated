{
  "name": "unbloated",
  "version": "0.1.0",
  "description": "Monospace grayscale theme for engineers.",
  "license": "LGPL-3.0-only",
  "author": "Jorge Martinez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgepiloto/unbloated-css.git"
  },
  "homepage": "https://github.com/jorgepiloto/unbloated-css#readme",
  "bugs": "https://github.com/jorgepiloto/unbloated-css/issues",
  "keywords": [
    "css",
    "theme",
    "monospace",
    "design-tokens",
    "unbloat"
  ],
  "type": "module",
  "style": "./dist/unbloat.css",
  "sass": "./dist/_tokens.scss",
  "unpkg": "./dist/unbloat.css",
  "jsdelivr": "./dist/unbloat.css",
  "exports": {
    ".": "./dist/unbloat.css",
    "./unbloat.css": "./dist/unbloat.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./tokens.scss": "./dist/_tokens.scss",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/build.mjs",
    "LICENSE",
    "COPYING",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run format:check && npm run build:check && npm test && npm run test:browser",
    "prepack": "npm run build",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.9.10",
    "sass": "1.105.1"
  }
}
